SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=metal-scans
SUPABASE_STORAGE_PRIVATE=true
SUPABASE_SIGNED_URL_TTL=3600
FRONTEND_ORIGINS=https://<vercel-project>.vercel.app,http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
MODEL_PATH=models/best.pt
# Input validation: minimum model confidence and minimum image share for metal (or fully rusted) surfaces
VALIDATION_CONFIDENCE=0.5
MIN_SURFACE_AREA_RATIO=0.05
# Rust % measurement inside the AI metal surface: color (rust-coloured pixels, default) or mask (model rust masks; only after retraining with tight rust labels)
RUST_MEASUREMENT=color
