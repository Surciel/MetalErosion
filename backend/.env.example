SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=metal-scans
SUPABASE_STORAGE_PRIVATE=true
SUPABASE_SIGNED_URL_TTL=3600
# Exact frontend origins, separated by commas; no trailing slash or URL path.
FRONTEND_ORIGINS=https://<vercel-project>.vercel.app,http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
MODEL_PATH=models/best.pt
# Docker uses Render's PORT automatically (10000 by default).
# Set these values in Render Environment; do not upload a .env into the image.
# Input validation: minimum model confidence and minimum image share for metal (or fully rusted) surfaces
VALIDATION_CONFIDENCE=0.5
MIN_SURFACE_AREA_RATIO=0.05
# --- Tested configuration: keep these three as they are ---
# Rust % measurement inside the AI metal surface:
#   hybrid = rust-coloured pixels, counted only in or near areas the model marked as rust (tested)
#   color  = all rust-coloured pixels inside the metal surface
#   mask   = the model's own rust outlines
RUST_MEASUREMENT=hybrid
# Stage 1 classifier (models/metal_cls.pt): minimum "metal" probability for a photo to pass
METAL_CLASSIFIER_THRESHOLD=0.4
# Detection confidence of the segmentation model, for metal and rust alike
MODEL_CONFIDENCE=0.15
# --- Optional overrides: leave these out to keep the tested behaviour ---
# The published test results do not hold if any of these is set.
# METAL_CLASSIFIER_PATH=models/metal_cls.pt
# HYBRID_REACH=0.02
# METAL_CONFIDENCE=0.15
# RUST_CONFIDENCE=0.15
# RUST_MIN_METAL_OVERLAP=0.5
